# This file is loaded automatically as a fallback template.
# Real local overrides should go into `.env`.

# Preferred single connection string:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/vanatur

# Or use separate PostgreSQL variables instead of DATABASE_URL:
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=vanatur
# PGUSER=postgres
# PGPASSWORD=postgres

# Used for admin-ready content/inquiries API routes:
ADMIN_API_KEY=admin
