{
  "name": "vanatur",
  "version": "1.0.0",
  "description": "Multi-page VANATUR website with a Python and PostgreSQL backend",
  "private": true,
  "main": "server.py",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
